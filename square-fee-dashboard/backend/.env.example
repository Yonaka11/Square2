# Backend environment configuration for the Square Fee Dashboard.
# Copy this file to `.env` and fill in values to enable real Square Sandbox sync.
# These are required to load data: the app uses only real Square data (no mock).
# With them set, run a sync (POST /api/sync/square) to import your Square data.

# Square API credentials (Sandbox recommended for development).
SQUARE_ACCESS_TOKEN=
SQUARE_ENVIRONMENT=sandbox
SQUARE_LOCATION_ID=

# Backend server port (frontend expects 8080 by default).
PORT=8080

# Path to the local SQLite database file (relative to repo root).
DATABASE_PATH=./data/square_dashboard.db

# --- Optional admin authentication ---
# Auth is OFF by default. Set ADMIN_PASSWORD to require an admin sign-in.
# SESSION_SECRET signs session tokens (defaults to ADMIN_PASSWORD if unset).
ADMIN_PASSWORD=
SESSION_SECRET=

# --- Optional Square webhooks ---
# If set, incoming webhooks are HMAC-verified. SQUARE_WEBHOOK_URL must match the
# exact notification URL configured in the Square Developer Dashboard.
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_WEBHOOK_URL=

# --- Production single-port serving ---
# When true (or NODE_ENV=production), the backend also serves the built frontend.
SERVE_STATIC=
# NODE_ENV=production
