# Root reference for environment variables used across the project.
# Each app also has its own .env.example (backend/.env.example, frontend/.env.example).

# --- Backend (copy to backend/.env) ---
SQUARE_ACCESS_TOKEN=
SQUARE_ENVIRONMENT=sandbox
SQUARE_LOCATION_ID=
PORT=8080
DATABASE_PATH=./data/square_dashboard.db

# Optional admin auth (off when blank):
ADMIN_PASSWORD=
SESSION_SECRET=

# Optional Square webhooks:
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_WEBHOOK_URL=

# Production single-port serving (backend serves built frontend):
SERVE_STATIC=

# --- Frontend (copy to frontend/.env) ---
VITE_API_TARGET=http://localhost:8080
